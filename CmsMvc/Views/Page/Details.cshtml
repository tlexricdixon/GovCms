@model CmsMvc.Models.PageDisplayViewModel

@{
    ViewData["Title"] = Model.Title;
}

<article>
    <h1>@Model.Title</h1>

    @foreach (var block in Model.Blocks)
    {
        switch (block.BlockType)
        {
            case Manager.Models.BlockType.Heading:
                switch (block.HeadingLevel)
                {
                    case 3:
                        <h3>@block.HeadingText</h3>
                        break;
                    case 4:
                        <h4>@block.HeadingText</h4>
                        break;
                    case 5:
                        <h5>@block.HeadingText</h5>
                        break;
                    case 6:
                        <h6>@block.HeadingText</h6>
                        break;
                    default:
                        <h2>@block.HeadingText</h2>
                        break;
                }
                break;

            case Manager.Models.BlockType.Paragraph:
                <p>@block.ParagraphText</p>
                break;

            case Manager.Models.BlockType.Link when block.LinkUrl is not null:
                <p>
                    <a href="@block.LinkUrl"
                       target="@(block.OpenInNewWindow ? "_blank" : null)"
                       rel="@(block.OpenInNewWindow ? "noopener noreferrer" : null)">
                        @block.LinkText
                    </a>
                </p>
                break;
        }
    }
</article>
