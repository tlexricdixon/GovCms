@model Page
@{
    ViewData["Title"] = Model.Title;
}

<article>
    <header>
        <p class="eyebrow">.NET 10 MVC frontend</p>
        <h1>@Model.Title</h1>
    </header>

    @* <p>@Model.Content</p> *@

    <dl>
        <dt>Slug</dt>
        <dd>@Model.Slug</dd>
        <dt>Published</dt>
        <dd>@(Model.IsPublished ? "Yes" : "No")</dd>
    </dl>

    <p class="security-note">
        Page content is Razor encoded. This view contains no <code>Html.Raw</code> call and no sanitizer package.
    </p>
</article>
