@model CmsModels.PageBlock

@{
    ViewData["Title"] = $"Edit {Model.BlockType} Block";
}

<h1>Edit @Model.BlockType Block</h1>

<form method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="PageId" type="hidden" />
    <input asp-for="BlockType" type="hidden" />

    @switch (Model.BlockType)
    {
        case CmsModels.BlockType.Heading:
            <div class="mb-3">
                <label asp-for="HeadingText"
                       class="form-label"></label>
                <input asp-for="HeadingText" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="HeadingLevel" 
                        class="form-label"></label>
                <select asp-for="HeadingLevel" class="form-select">
                    <option value="2">Heading 2</option>
                    <option value="3">Heading 3</option>
                    <option value="4">Heading 4</option>
                </select>
            </div>
            break;

        case CmsModels.BlockType.Paragraph:
            <div class="mb-3">
                <label asp-for="ParagraphText"
                       class="form-label"></label>
                <textarea asp-for="ParagraphText"
                          class="form-control"
                          rows="6"></textarea>
            </div>
            break;

        case CmsModels.BlockType.Link:
            <div class="mb-3">
                <label asp-for="LinkText" 
                        class="form-label"></label>
                <input asp-for="LinkText" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="LinkUrl" 
                        class="form-label"></label>
                <input asp-for="LinkUrl" class="form-control" />
            </div>

            <div class="form-check mb-3">
                <input asp-for="OpenInNewWindow"
                       class="form-check-input" />
                <label asp-for="OpenInNewWindow"
                       class="form-check-label"></label>
            </div>
            break;
    }

    <button type="submit" class="btn btn-primary">
        Save Block
    </button>
</form>
