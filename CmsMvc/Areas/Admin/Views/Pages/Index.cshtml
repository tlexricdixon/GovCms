@model IReadOnlyList<CmsModels.Page>

@{
    ViewData["Title"] = "Pages";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Pages</h1>
        <p class="text-muted mb-0">
            Create and manage website pages.
        </p>
    </div>

    <a asp-area="Admin"
       asp-controller="Pages"
       asp-action="Create"
       class="btn btn-primary">
        Create Page
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No pages have been created yet.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Slug</th>
                <th scope="col">Status</th>
                <th scope="col">Modified</th>
                <th scope="col">
                    <span class="visually-hidden">Actions</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pages in Model)
            {
                <tr>
                    <td>@pages.Title</td>
                    <td>
                        <code>@pages.Slug</code>
                    </td>
                    <td>
                        @(pages.IsPublished ? "Published" : "Draft")
                    </td>
                    <td>@pages.LastModified.ToLocalTime()</td>
                    <td class="text-end">
                        <a asp-area="Admin"
                           asp-controller="Pages"
                           asp-action="Edit"
                           asp-route-id="@pages.Id">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
