<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - GovCms Administration</title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="admin-body">
    <a class="admin-skip-link" href="#admin-main">Skip to main content</a>

    <div class="admin-shell">
        <aside class="admin-sidebar" id="admin-sidebar">
            <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="admin-brand-mark" aria-hidden="true">G</span>
                <span>
                    <strong>GovCms</strong>
                    <small>Administration</small>
                </span>
            </a>

            <nav class="admin-nav" aria-label="Administration">
                <p class="admin-nav-label">Workspace</p>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="admin-nav-icon" aria-hidden="true">⌂</span>
                    Dashboard
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Pages" asp-action="Index">
                    <span class="admin-nav-icon" aria-hidden="true">▤</span>
                    Pages
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                <span class="admin-environment">Development</span>
                <a asp-area="" asp-controller="Home" asp-action="Index">View website</a>
            </div>
        </aside>

        <div class="admin-workspace">
            <header class="admin-topbar">
                <button class="admin-menu-button" type="button" aria-label="Open navigation" aria-controls="admin-sidebar">
                    <span aria-hidden="true">☰</span>
                </button>
                <div class="admin-topbar-title">Content management</div>
                <div class="admin-user" aria-label="Current user">
                    <span class="admin-avatar" aria-hidden="true">A</span>
                    <span>Administrator</span>
                </div>
            </header>

            <main id="admin-main" class="admin-main" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/bootstrap/js/bootstrap.bundle.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
